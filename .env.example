# LiteLLM Configuration
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=sk-master-...
DEFAULT_LLM_MODEL=glm-5.3-flash
MODEL_FAST=glm-5.3-flash
MODEL_MID=glm-5.3-flash
MODEL_STRONG=strong

# PostgreSQL + pgvector Configuration
POSTGRES_HOST=study-rag-db
POSTGRES_PORT=5432
POSTGRES_DB=study_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# LangSmith Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=study-rag-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Embedding Configuration
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
MIN_SIMILARITY_THRESHOLD=0.50

# Hermes Agent (GLM 5.3 Flash via LiteLLM Virtual Key + Langfuse)
HERMES_LITELLM_KEY=sk-T-arQ7cEWBQo0H6xNkMCmA
LITELLM_HOST_URL=http://127.0.0.1:4000/v1

# Ops Bot LiteLLM Virtual Key & Observability
LITELLM_OPS_KEY=sk-ops-...
LANGCHAIN_OPS_PROJECT=study-rag-ops-bot

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_OPS_BOT_TOKEN=seu_token_ops_aqui
TELEGRAM_ADMIN_CHAT_ID=seu_chat_id_opcional_aqui

# Revisão Espaçada (Curva do Esquecimento - Ebbinghaus)
REVISAO_INTERVALOS_DIAS=1,7,15,30
REVISAO_HORA_AGENDAMENTO=8
REVISAO_TZ_OFFSET_HORAS=-3
